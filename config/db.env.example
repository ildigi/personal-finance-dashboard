# Credenziali del database in un file separato (alternativa a DATABASE_URL in backend/.env,
# consigliata con i dati veri): copia in ${DATA_DIR}/secrets/db.env, che è fuori da Git,
# e togli DATABASE_URL / TEST_DATABASE_URL da backend/.env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=finance_app
DB_PASSWORD=
DB_NAME=finance
DB_NAME_TEST=finance_test
