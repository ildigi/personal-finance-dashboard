# =====================================================================
# Finance Dashboard — variabili d'ambiente (ESEMPIO, nessun valore reale)
# Copia in backend/.env e compila. backend/.env è ignorato da Git.
# Le chiavi API NON vanno qui: stanno in ${DATA_DIR}/secrets/.
# =====================================================================

# Ambiente: local | production
APP_ENV=local

# Modalità demo: all'avvio migrazioni, seed e 15+ mesi di dati inventati, nessuna
# credenziale. Per usare i tuoi conti: false (e `python -m app.ingestion.cli mock-remove --yes`).
DEMO_MODE=true

# Cartella dei dati (segreti, backup, log), mai in Git. Default: data/ nella radice del repo.
# DATA_DIR=D:/FinanceData

# Backend: ascolta solo in locale
API_HOST=127.0.0.1
API_PORT=8000

# Origini ammesse dal backend (frontend Vite in sviluppo), separate da virgola
CORS_ORIGINS=https://localhost:5173,http://localhost:5173
# Host ammessi nell'header Host (protezione dal DNS rebinding), separati da virgola
ALLOWED_HOSTS=127.0.0.1,localhost

# Database. Valori pronti per il PostgreSQL di `docker compose up -d db` (compose.yaml).
# Con PostgreSQL installato a mano: database/create-databases.sql e la tua password.
DATABASE_URL=postgresql+psycopg://finance_app:finance@127.0.0.1:5432/finance
TEST_DATABASE_URL=postgresql+psycopg://finance_app:finance@127.0.0.1:5432/finance_test
# Con i dati veri, meglio le credenziali in un file fuori dal repo: togli le due righe sopra
# e crea ${DATA_DIR}/secrets/db.env da config/db.env.example (oppure indica il file qui).
# DB_ENV_FILE=${DATA_DIR}/secrets/db.env

# Segreti dei provider (file, non valori)
TRADING212_ENV_FILE=${DATA_DIR}/secrets/trading212.env
# Sincronizzazione automatica di Trading 212 (minuti) mentre il backend è acceso; 0 = spenta
T212_AUTO_SYNC_MINUTES=10
# Enable Banking: application ID, ambiente e nome della chiave stanno in
# ${DATA_DIR}/secrets/enablebanking.env (EB_APPLICATION_ID, EB_ENV=sandbox|production,
# EB_KEY_FILE=enablebanking.pem); la chiave privata nello stesso file .pem accanto.
# Indirizzo di ritorno dopo il consenso: identico a quello registrato nel Control Panel.
EB_REDIRECT_URL=https://localhost:5173/impostazioni/ritorno-banca
# Sincronizzazione automatica delle banche (ore, minimo 6 = 4 al giorno; 0 = spenta)
EB_AUTO_SYNC_HOURS=6

# Chiave di cifratura dei token salvati in DB
ENCRYPTION_KEY_FILE=${DATA_DIR}/secrets/app.key

# Fuso orario di visualizzazione
APP_TIMEZONE=Europe/Rome

# Il tuo nome come compare nelle causali (es. "MARIO ROSSI,ROSSI MARIO"), separato da
# virgola: aiuta a riconoscere i giroconti tra i tuoi conti. Solo in backend/.env.
OWNER_NAMES=

# I comuni di casa, separati da virgola: i pagamenti con carta fatti altrove
# (città o paese nella causale) vanno in Viaggi. Vuoto = regola spenta. Solo in backend/.env.
HOME_PLACES=

# Accesso con password + codice TOTP: spento in locale (solo localhost), obbligatorio sul
# server di casa. Prima: uv run python -m app.auth.cli setup
AUTH_ENABLED=false

# Backup cifrati (chiave ${DATA_DIR}/secrets/backup.key): ogni quante ore (0 = spenti),
# quanti tenerne, database di prova per il ripristino (si svuota: nome *_test o *_restore)
BACKUP_HOURS=0
BACKUP_KEEP=30
BACKUP_VERIFY_DB=finance_test
# Cartella di pg_dump/pg_restore se non sono nel PATH (Windows: D:/Programs/PostgreSQL/18/bin)
# PG_BIN_DIR=

# Frontend compilato da servire dal backend (solo sul server; in locale c'è Vite)
# STATIC_DIR=

# Livello di log: DEBUG | INFO | WARNING
LOG_LEVEL=INFO
