# Server di casa: copia in deploy/.env e compila. deploy/.env NON va mai in Git.
# Password: solo lettere e cifre, lunghe (es. `openssl rand -hex 24`).

# Database
POSTGRES_PASSWORD=
DB_PASSWORD=

# Cartella sul server con segreti, backup e log (montata in /data nel container)
DATA_PATH=./data

# Indirizzo della dashboard su Tailscale (es. finanze.tailnet-1234.ts.net)
ALLOWED_HOSTS=finanze.tailnet-xxxx.ts.net,localhost,127.0.0.1
CORS_ORIGINS=https://finanze.tailnet-xxxx.ts.net
EB_REDIRECT_URL=https://finanze.tailnet-xxxx.ts.net/impostazioni/ritorno-banca

# Accesso obbligatorio sul server (password + codice): prima esegui il setup (DEPLOY.md)
AUTH_ENABLED=true

# Dati veri: niente dati di prova
DEMO_MODE=false

# Fuso orario e preferenze della classificazione (come in backend/.env)
APP_TIMEZONE=Europe/Rome
OWNER_NAMES=
HOME_PLACES=

# Sincronizzazioni automatiche e backup
T212_AUTO_SYNC_MINUTES=10
EB_AUTO_SYNC_HOURS=6
BACKUP_HOURS=24
BACKUP_KEEP=30
